---
import GitHub from "@/icons/GitHub.astro"
import LinkedIn from "@/icons/LinkedIn.astro"
import Mail from "@/icons/Mail.astro"
import Phone from "@/icons/Phone.astro"
import Pin from "@/icons/Pin.astro"
import Section from "@/components/Section.astro"
import WorldMap from "@/icons/WorldMap.astro"
import X from "@/icons/X.astro"
import YouTube from "@/icons/YouTube.astro"
import type { Icon } from "@/types"

const basics = Astro.props.cv.basics

const { name, label, image, email, phone, url, location, profiles } = basics
const { city, region } = location
const SOCIAL_NETWORKS_ICONS: Icon = {
  GitHub,
  LinkedIn,
  X,
  YouTube,
}

interface Profile {
  network: string
  url: string
}

const linkedInfo = profiles.find(
  ({ network }: Profile) => network === "LinkedIn",
)
const linkedUrl = linkedInfo?.url

const printInfo = [email, phone, linkedUrl].filter(Boolean).join(" | ")
---

<Section>
  <div class="hero">
    <div class="info">
      <h1>{name}</h1>
      <p>{label}</p>
      <p>
        <a
          id="location"
          href="https://www.google.com/maps/place/San+Juan"
          target="_blank"
          rel="noopener noreferrer"
        >
          <Pin />
          {city}, {region}
        </a>
      </p>
      <footer class="print">
        <a id="printable">{printInfo}</a>
      </footer>
      <footer class="no-print">
        {
          url && (
            <a
              href={url}
              title="Website"
              target="_blank"
              rel="noopener noreferrer"
            >
              <WorldMap />
            </a>
          )
        }
        {
          email && (
            <a
              href={`mailto:${email}`}
              title={`Email: ${email}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Mail />
            </a>
          )
        }
        {
          phone && (
            <a
              href={`tel:${phone}`}
              title={`Phone: ${phone}`}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Phone />
            </a>
          )
        }
        {
          profiles.map(({ network, url }: Profile) => {
            const Icon = SOCIAL_NETWORKS_ICONS[network]
            return (
              <a
                href={url}
                title={`${network}`}
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon />
              </a>
            )
          })
        }
      </footer>
    </div>
    <figure class="profile-container" data-track-zone="800">
      <div class="profile-wrapper">
        <img src={image} alt={name} class="profile-image" />
        <div class="shimmer-overlay"></div>
      </div>
    </figure>
  </div>

  <style>
    .hero {
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
      gap: 1rem;
    }

    .info {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-right: 32px;
    }

    h1 {
      font-size: 2rem;
    }

    p {
      color: #666;
      font-weight: 500;
      font-size: 1.1rem;
      text-wrap: balance;
    }

    .profile-container {
      perspective: 1000px;
      width: 160px;
      height: 160px;
      position: relative;
    }

    .profile-wrapper {
      width: 100%;
      height: 100%;
      position: relative;
      transform-style: preserve-3d;
      transition: transform 0.3s ease-out;
    }

    .profile-wrapper.coin-flip-x {
      animation: coinFlipX 2s cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    .profile-wrapper.coin-flip-y {
      animation: coinFlipY 2s cubic-bezier(0.25, 0.1, 0.25, 1);
    }

    @keyframes coinFlipX {
      0% { transform: rotateX(0deg); }
      25% { transform: rotateX(1800deg); }
      50% { transform: rotateX(2520deg); }
      75% { transform: rotateX(2700deg); }
      90% { transform: rotateX(2820deg); }
      100% { transform: rotateX(2880deg); }
    }

    @keyframes coinFlipY {
      0% { transform: rotateY(0deg); }
      25% { transform: rotateY(1800deg); }
      50% { transform: rotateY(2520deg); }
      75% { transform: rotateY(2700deg); }
      90% { transform: rotateY(2820deg); }
      100% { transform: rotateY(2880deg); }
    }

    .profile-image {
      aspect-ratio: 1 / 1;
      object-fit: cover;
      width: 160px;
      height: 160px;
      border-radius: 50%;
      cursor: pointer;
      position: relative;
      z-index: 1;
    }

    .shimmer-overlay {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      pointer-events: none;
      background: linear-gradient(
        135deg,
        transparent 30%,
        rgba(255, 255, 255, 0.6) 50%,
        transparent 70%
      );
      background-size: 200% 200%;
      background-position: -100% -100%;
      opacity: 0;
      transition: opacity 0.4s ease, background-position 0.2s ease-out;
      z-index: 2;
    }

    #location {
      color: #666;
      font-size: 0.85rem;
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      letter-spacing: -0.05rem;
    }

    #location:hover {
      text-decoration: underline;
    }

    footer {
      color: #555;
      font-size: 0.75rem;
      display: flex;
      gap: 4px;
      margin-top: 8px;
    }

    a:not(#location, #printable) {
      align-items: center;
      justify-content: center;
      border: 1px solid #eee;
      padding: 4px;
      height: 32px;
      width: 32px;
      border-radius: 6px;
      transition:
        background 0.3s,
        ease;
    }

    a:hover:not(#location, #printable) {
      background: #eee;
      border: 1px solid #ddd;
    }

    @media (max-width: 768px) {
      h1 {
        letter-spacing: -0.1rem;
      }
      .hero {
        flex-direction: column;
        align-items: center;
      }
      .profile-container {
        width: 90vw;
        max-width: 320px;
        height: auto;
        margin: 0 auto 1rem auto;
        display: flex;
        justify-content: center;
        align-items: center;
      }
      .profile-wrapper {
        width: 100%;
        height: auto;
        min-width: 0;
        min-height: 0;
      }
      .profile-image {
        width: 100%;
        max-width: 320px;
        height: auto;
        display: block;
        margin: 0 auto;
        border-radius: 50%;
        object-fit: cover;
      }
      .shimmer-overlay {
        display: none !important;
      }
    }
  </style>

  <script>
    const isMobile = window.matchMedia('(max-width: 768px)').matches;
    const profileContainer = document.querySelector('.profile-container');
    const profileWrapper = document.querySelector('.profile-wrapper');
    const shimmerOverlay = document.querySelector('.shimmer-overlay');

    if (!isMobile && profileContainer && profileWrapper && shimmerOverlay) {
      // Get tracking zone size from data attribute (default 200px)
      const trackZone = parseInt(profileContainer.dataset.trackZone) || 200;
      let isInZone = false;
      // Use document-level mouse tracking for proper zone detection
      document.addEventListener('mousemove', (e) => {
        const rect = profileContainer.getBoundingClientRect();
        const centerX = rect.left + rect.width / 2;
        const centerY = rect.top + rect.height / 2;
        const mouseX = e.clientX - centerX;
        const mouseY = e.clientY - centerY;
        // Check if mouse is within the tracking zone
        const distance = Math.sqrt(mouseX * mouseX + mouseY * mouseY);
        const wasInZone = isInZone;
        isInZone = distance <= trackZone / 2;
        // Create buffer zones for shimmer (smaller than tracking zone)
        const shimmerZone = trackZone * 0.75; // 75% of tracking zone
        const isInShimmerZone = distance <= shimmerZone / 2;
        if (isInZone) {
          // Calculate rotation angles
          const rotateX = (mouseY / (trackZone / 4)) * -15; // Max 15 degrees
          const rotateY = (mouseX / (trackZone / 4)) * 15;   // Max 15 degrees
          // Apply rotation
          profileWrapper.style.transform = `rotateX(${rotateX}deg) rotateY(${rotateY}deg)`;
          // Only show shimmer in the inner zone to prevent edge jumpiness
          if (isInShimmerZone) {
            shimmerOverlay.style.opacity = '1';
            const shimmerX = ((mouseX / (shimmerZone / 2)) * 50) + 50; // 0-100%
            const shimmerY = ((mouseY / (shimmerZone / 2)) * 50) + 50; // 0-100%
            shimmerOverlay.style.backgroundPosition = `${shimmerX}% ${shimmerY}%`;
          } else {
            // Fade out shimmer near edges but keep rotation
            shimmerOverlay.style.opacity = '0';
          }
        } else if (wasInZone) {
          // Smoothly return to center when exiting zone
          profileWrapper.style.transform = 'rotateX(0deg) rotateY(0deg)';
          shimmerOverlay.style.opacity = '0';
          shimmerOverlay.style.backgroundPosition = '-100% -100%';
        }
      });
    }
  </script>
</Section>
