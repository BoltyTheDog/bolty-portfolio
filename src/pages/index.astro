---
// This page redirects to the appropriate locale based on browser language
---

<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <title>Redirecting...</title>
  <script>
    // Get browser language preference
    const browserLang = navigator.language || navigator.languages[0];
    const lang = browserLang.toLowerCase();
    
    // Redirect based on language preference
    if (lang.startsWith('es')) {
      window.location.href = '/es/';
    } else if (lang.startsWith('ca')) {
      window.location.href = '/es/'; // Catalan users go to Spanish
    } else {
      window.location.href = '/en/';
    }
  </script>
  <noscript>
    <meta http-equiv="refresh" content="0; url=/en/">
  </noscript>
</head>
<body>
  <p>Redirecting to your preferred language...</p>
  <p>If you're not redirected, <a href="/en/">click here</a>.</p>
</body>
</html>
